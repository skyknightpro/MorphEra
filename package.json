{
  "name": "morphera",
  "productName": "MorphEra",
  "version": "1.0.0",
  "description": "MorphEra - fast, private, unlimited file conversion",
  "author": "MorphEra",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env MORPH_DEV=1 electron .\"",
    "build:ui": "vite build",
    "icon": "node scripts/make-icon.mjs",
    "start": "npm run build:ui && electron .",
    "dist": "npm run icon && npm run build:ui && electron-builder --win portable",
    "dist:folder": "npm run icon && npm run build:ui && electron-builder --win dir"
  },
  "dependencies": {
    "@tesseract.js-data/ara": "latest",
    "@tesseract.js-data/eng": "latest",
    "chokidar": "^3.6.0",
    "docx": "^9.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.8.0",
    "mupdf": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "sharp": "^0.34.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@imgly/background-removal-node": "^1.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.morphera.app",
    "productName": "MorphEra",
    "asar": false,
    "directories": { "output": "release", "buildResources": "build" },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico",
      "artifactName": "MorphEra.exe"
    },
    "portable": { "artifactName": "MorphEra.exe" },
    "compression": "maximum"
  }
}
